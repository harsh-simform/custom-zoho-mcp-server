# Copy this file to .env and fill in real values. .env is gitignored — never commit
# actual secrets. Nothing in this file is a real value, only placeholders.

# Required — from your Zoho Self Client at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional — default portal/project, auto-selected at startup so
# select_portal_and_project doesn't need to be called manually every session.
# Leave blank to select interactively via list_portals / list_projects instead.
ZOHO_PORTAL_ID=
ZOHO_PROJECT_ID=

# Optional — overrides, see README for the full list and defaults.
# ZOHO_DC=com
# ZOHO_MCP_ENV_FILE=/absolute/path/to/.env
# ZOHO_MCP_LOG_LEVEL=INFO
# ZOHO_MCP_LOG_FILE=/absolute/path/to/server.log
# ZOHO_MCP_MAX_CONTEXT_IMAGES=5
# ZOHO_MCP_MAX_ATTACHMENT_BYTES=8388608
